# Local database location (defaults to backend/phishguard.db)
PHISHGUARD_DB=backend/phishguard.db
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Production: JSON object mapping API token to role (viewer, analyst, admin).
# Example only; replace with long random tokens. Leave unset for local single-user demo.
# PHISHGUARD_API_KEYS={"REPLACE_WITH_LONG_RANDOM_TOKEN":"admin","ANALYST_TOKEN":"analyst","VIEWER_TOKEN":"viewer"}

# Optional external reputation services. Indicators are sent only after explicit user consent.
VIRUSTOTAL_API_KEY=
